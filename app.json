{
  "expo": {
    "name": "Tripwise",
    "slug": "tripwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tripwise",
    "icon": "./assets/tripwise-icon-light.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/tripwise-icon-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#ECE9F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tripwise.app",
      "associatedDomains": [
        "applinks:tripwise.raghavgaba.me"
      ],
      "icon": {
        "light": "./assets/tripwise-icon-light.png",
        "dark": "./assets/tripwise-icon-dark.png"
      }
    },
    "android": {
      "package": "com.tripwise.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tripwise.raghavgaba.me",
              "pathPrefix": "/join/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/tripwise-icon-light.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/tripwise-icon-foreground.png",
        "monochromeImage": "./assets/tripwise-icon-foreground.png",
        "backgroundColor": "#0E0C18"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/tripwise-icon-light.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tripwise to choose a group cover photo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ECE9F5",
          "image": "./assets/tripwise-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0E0C18",
            "image": "./assets/tripwise-icon-dark.png"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4aef196-24c2-41fa-a1d5-ca9267e3e6f8"
      }
    },
    "owner": "raghavvvgaba",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a4aef196-24c2-41fa-a1d5-ca9267e3e6f8"
    }
  }
}
